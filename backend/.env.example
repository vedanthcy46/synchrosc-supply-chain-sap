APP_ENV=development
API_PREFIX=/api
# Local demo database (safe default). For Neon, replace with the PostgreSQL URL
# in your ignored backend/.env file; never commit credentials.
DATABASE_URL=sqlite:///./synchrosc.db
CORS_ORIGINS=http://localhost:5173
LLM_PROVIDER=mock
LLM_API_KEY=
AUTO_APPROVAL_LIMIT_INR=50000
EXECUTION_MODE=simulation
USE_DEMO_SEED=true
