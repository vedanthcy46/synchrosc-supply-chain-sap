# SynchroSC Frontend — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# Never commit .env to source control.

# Backend API base URL (must include /api prefix)
VITE_API_BASE_URL=http://localhost:8000/api

# Set to "true" to use the built-in mock provider (no backend required)
# Set to "false" to connect to the live backend API
VITE_DEMO_MODE=true
